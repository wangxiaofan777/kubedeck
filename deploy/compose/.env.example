# 复制为 .env 后填写，并执行 chmod 600 .env。
# 不要把真实的 .env 提交到仓库或发到聊天工具。

# ---- 镜像与入口 ----
# 本地构建时保持默认；生产建议固定到不可变 tag，例如 registry.example.com/kubedeck:0.1.0
KUBEDECK_IMAGE=kubedeck:local
# 浏览器访问的域名。Caddy 会为该域名自动申请证书。
# 本地快速验证可填 localhost（Caddy 使用本地 CA）。
KUBEDECK_DOMAIN=kubedeck.example.com

# ---- PostgreSQL ----
POSTGRES_DB=kubedeck
POSTGRES_USER=kubedeck
# 必填：使用强随机密码，不要使用示例值。
POSTGRES_PASSWORD=change-me-strong-random-password

# ---- 平台配置 ----
# 必填：openssl rand -base64 32 生成，32 字节 base64。
# 丢失后已登记的集群凭据无法解密，必须与数据库备份分开保管。
KUBEDECK_MASTER_KEY=replace-with-base64-32-bytes
KUBEDECK_MASTER_KEY_VERSION=1

# ---- OIDC ----
# 必填：与 IdP discovery 返回的 issuer 完全一致。
KUBEDECK_OIDC_ISSUER=https://idp.example.com
# 必填：IdP 中创建的 confidential client。
KUBEDECK_OIDC_CLIENT_ID=kubedeck
KUBEDECK_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# 必填：必须与 IdP 中配置的回调地址一致。
KUBEDECK_OIDC_REDIRECT_URL=https://kubedeck.example.com/auth/callback
KUBEDECK_OIDC_SCOPES=openid,profile,email,groups

# 必填（首次启动）：至少 16 个字符；创建首个管理员后接口自动失效。
KUBEDECK_BOOTSTRAP_TOKEN=replace-with-random-bootstrap-token

# ---- 可选 ----
# 生产必须为 false；只有在本地纯 HTTP 调试时才设为 true。
KUBEDECK_COOKIE_INSECURE=false
KUBEDECK_SESSION_TTL_HOURS=8
KUBEDECK_MAX_SESSIONS_PER_USER=5
KUBEDECK_LOG_LEVEL=info
# 仅跨域部署时填写，逗号分隔；不要使用 *。
KUBEDECK_ALLOWED_ORIGINS=