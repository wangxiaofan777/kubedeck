{$KUBEDECK_DOMAIN} {
	encode zstd gzip

	# 离线环境无法完成公网 ACME 验证，默认使用 Caddy 内部 CA。
	# 浏览器需要安装 /data/caddy/pki/authorities/local/root.crt 才不告警。
	#
	# 若已有企业 CA，替换为证书文件，并在离线覆盖文件中挂载 ./certs：
	#   tls /etc/caddy/certs/tls.crt /etc/caddy/certs/tls.key
	tls internal

	# flush_interval -1 让 WebSocket 与日志流立即刷新，避免反向代理缓冲。
	reverse_proxy kubedeck:8080 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format console
	}
}