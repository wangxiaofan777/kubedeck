exports[`buildManifest > snapshots a representative Deployment 1`] = `
{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "sample-app",
    "namespace": "default",
  },
  "spec": {
    "replicas": 2,
    "selector": {
      "matchLabels": {
        "app": "sample-app",
      },
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "sample-app",
        },
      },
      "spec": {
        "containers": [
          {
            "image": "nginx:1.27",
            "name": "sample-app",
            "ports": [
              {
                "containerPort": 80,
                "protocol": "TCP",
              },
            ],
            "resources": {
              "limits": {
                "cpu": "500m",
                "memory": "512Mi",
              },
              "requests": {
                "cpu": "100m",
                "memory": "128Mi",
              },
            },
          },
        ],
      },
    },
  },
}
`;
